# 실제 AppsInToss 광고 그룹 ID가 준비된 환경에서만 true로 바꾸세요.
VITE_ENABLE_ADS=true
# 지면별 중지 스위치. 로컬 개발에서는 코드가 공식 테스트 광고 ID를 사용합니다.
VITE_ENABLE_RESULT_BANNER=true
VITE_ENABLE_INTERSTITIAL=true
VITE_AIT_BANNER_AD_GROUP_ID=ait.v2.live.ce0e8c9591fb4566
VITE_AIT_INTERSTITIAL_AD_GROUP_ID=ait.v2.live.d5fe45597c574a60

# 비워 두면 분석 SDK를 초기화하지 않습니다.
VITE_AMPLITUDE_API_KEY=
